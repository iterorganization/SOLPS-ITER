#
# Specify paths to root-directories of following libraries on your system
#

NAGDIR    ?= $(NAG_DIR)
BLAS_DIR  ?=
NCARG_ROOT ?=
NCARG_LIB_DIR ?= $(if $(NCARG_ROOT),$(NCARG_ROOT)/lib,)
MSCL_ROOT ?=
GR_ROOT   ?= $(GR_SOURCE)
GLI_HOME  ?=
MDSPLUS_DIR =
H5DIR =
BLAS_LIB ?= blas
LAPACK_LIB ?= lapack
NCDIR ?= /usr

ifeq ($(ORNL_SYSTEM),EOS)
  BLAS_LIB = openblas
endif

ifeq ($(ORNL_SYSTEM),ultrabucky)
  NCDIR = /usr/lib/x86_64-linux-gnu/hdf5/openmpi
  NAGDIR = /usr/lib/x86_64-linux-gnu/lapack
  BLAS_DIR = /usr/lib/x86_64-linux-gnu/blas
  NCARG_ROOT = /usr/lib/x86_64-linux-gnu/ncarg
  LD_NETCDF = -L${NCDIR} -lnetcdf -lnetcdff -lstdc++ -lhdf5
endif

#
# Variables for linking
#

LD_NETCDF ?= -L${NETCDF_F_ROOT}/lib -lnetcdff -L${NETCDF_C_ROOT}/lib -lnetcdf

ifneq ($(wildcard $(MKLROOT)),)
  $(info ORNL config: PARDISO enabled using MKLROOT=${MKLROOT})
  MKL_LIB_DIR ?= ${MKLROOT}/lib
  LD_NAG      = -L${MKL_LIB_DIR} -lmkl_gf_lp64 -lmkl_sequential -lmkl_core -lpthread -lm -ldl
else
  $(info ORNL config: PARDISO disabled; MKLROOT is not set or does not exist)
  LD_NAG      = -L${NAGDIR} -l${LAPACK_LIB} -L${BLAS_DIR} -l${BLAS_LIB}
endif
LD_MSCL    = -L${MSCL_ROOT} -lmscl
LD_GR      = -L${GR_ROOT} -lgr
LD_GKS     = -L${GLI_HOME} -lgks
ifneq ($(wildcard $(NCARG_LIB_DIR)/libncarg.a),)
  LD_NCARG = ${NCARG_LIB_DIR}/libncarg.a ${NCARG_LIB_DIR}/libncarg_gks.a ${NCARG_LIB_DIR}/libncarg_c.a -L/usr/lib/x86_64-linux-gnu -lX11 -lm -lgfortran -lcairo -lgcc_s -lfreetype
else
  LD_NCARG =
endif
LD_MDSPLUS =
LD_SONNET  = -L${SOLPSLIB} -lsonnet -lstdc++ -lC

LIBGKS     = ${GLI_HOME}/libgks.a
LIBGRS     = ${GR_ROOT}/libgr.a

#
# Provide compiler
#

MPI_FC    ?= /usr/bin/mpif90
ifdef SOLPS_MPI
FC         = ${MPI_FC}
endif

#
# Preprocessor options
#

SOLPS_CPP      = -DNCAR4 -DNO_NAG
B25_DEFINES    =
CARRE_DEFINES  =
EIRENE_DEFINES =
FFLAGSEXTRA    =


#!!!Local Variables:
#!!! mode: Makefile
#!!! End:
